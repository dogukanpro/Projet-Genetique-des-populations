    "import re\n",
    "\n",
    "\n",
    "sequence = \"ATGCAGTCGAGT\"\n",
    "motif_chimique = \"[AG][CT]\"\n",
    "\n",
    "resultats = re.findall(motif_chimique, sequence)\n",
    "\n",
    "print(f\"Analyse de la séquence : {sequence}\")\n",
    "print(f\"Paires correspondant au motif trouvées : {resultats}\")"
   ]
