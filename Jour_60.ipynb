   "source": [
    "Sujet : Slicing (avec pour exemple les codons)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "cb593c7d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Séquence complète : ATGCCGTAGA\n",
      "\n",
      "Codon 1 : ATG\n",
      "Codon 2 : TGC\n",
      "Codon 3 : GCC\n",
      "Codon 4 : CCG\n",
      "Codon 5 : CGT\n",
      "Codon 6 : GTA\n",
      "Codon 7 : TAG\n",
      "Codon 8 : AGA\n"
     ]
    }
   ],
   "source": [
    "adn = \"ATGCCGTAGA\"\n",
    "taille_fenetre = 3\n",
    "\n",
    "print(f\"Séquence complète : {adn}\\n\")\n",
    "\n",
    "for i in range(0, len(adn) - taille_fenetre + 1):\n",
    "    codon = adn[i : i + taille_fenetre]\n",
    "    \n",
    "    print(f\"Codon {i+1} : {codon}\")"
   ]
  }
 ],
