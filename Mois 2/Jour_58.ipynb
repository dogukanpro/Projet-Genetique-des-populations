   "source": [
    "population = [2, 4, 8, 16, 32, 50, 65, 75, 80, 82]\n",
    "\n",
    "for gen, n in enumerate(population):\n",
    "    # On multiplie le caractère par l'effectif divisé par 2\n",
    "    print(f\"G{gen+1}: {'#' * (n // 2)} ({n})\")"
   ]
  }
